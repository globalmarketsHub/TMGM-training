generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_TEXT
}

enum TimeLogSource {
  TIMER
  VIDEO
  MANUAL
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash")
  role         Role
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  employee Employee?

  @@map("users")
}

model Employee {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  employeeCode String    @unique @map("employee_code") @db.VarChar(50)
  fullName     String    @map("full_name") @db.VarChar(120)
  department   String?   @db.VarChar(120)
  position     String?   @db.VarChar(120)
  manager      String?   @db.VarChar(120)
  hiredAt      DateTime? @map("hired_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress       TrainingProgress[]
  activeTimeLogs ActiveTimeLog[]
  examAnswers    ExamAnswer[]
  examResults    ExamResult[]

  @@index([department])
  @@map("employees")
}

model TrainingDay {
  id           String   @id @default(uuid()) @db.Uuid
  dayNumber    Int?     @unique @map("day_number")
  title        String   @db.VarChar(180)
  summary      String
  contentJson  Json     @map("content_json")
  videoUrl     String?  @map("video_url")
  pdfUrl       String?  @map("pdf_url")
  linkUrl      String?  @map("link_url")
  isFinalExam  Boolean  @default(false) @map("is_final_exam")
  isPublished  Boolean  @default(true) @map("is_published")
  sortOrder    Int      @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  progress       TrainingProgress[]
  activeTimeLogs ActiveTimeLog[]

  @@index([sortOrder])
  @@map("training_days")
}

model TrainingProgress {
  id            String         @id @default(uuid()) @db.Uuid
  employeeId    String         @map("employee_id") @db.Uuid
  trainingDayId String         @map("training_day_id") @db.Uuid
  status        TrainingStatus @default(NOT_STARTED)
  activeSeconds Int            @default(0) @map("active_seconds")
  lastOpenedAt  DateTime?      @map("last_opened_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)

  @@unique([employeeId, trainingDayId])
  @@index([trainingDayId])
  @@map("training_progress")
}

model ActiveTimeLog {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  trainingDayId   String        @map("training_day_id") @db.Uuid
  startedAt       DateTime      @map("started_at")
  endedAt         DateTime      @map("ended_at")
  durationSeconds Int           @map("duration_seconds")
  source          TimeLogSource @default(TIMER)
  clientMeta      Json?         @map("client_meta")
  createdAt       DateTime      @default(now()) @map("created_at")

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  trainingDay TrainingDay @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)

  @@index([employeeId, trainingDayId])
  @@index([startedAt])
  @@map("active_time_logs")
}

model ExamQuestion {
  id            String       @id @default(uuid()) @db.Uuid
  type          QuestionType
  prompt        String
  options       Json?
  correctAnswer String?      @map("correct_answer")
  score         Int          @default(10)
  sortOrder     Int          @unique @map("sort_order")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  answers ExamAnswer[]

  @@map("exam_questions")
}

model ExamResult {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  score       Int
  totalScore  Int      @map("total_score")
  passed      Boolean
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  answers  ExamAnswer[]

  @@index([employeeId, submittedAt])
  @@map("exam_results")
}

model ExamAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  examResultId String   @map("exam_result_id") @db.Uuid
  answerText   String   @map("answer_text")
  isCorrect    Boolean? @map("is_correct")
  scoreAwarded Int      @default(0) @map("score_awarded")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  result   ExamResult   @relation(fields: [examResultId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([examResultId])
  @@map("exam_answers")
}
